#include <winres.h>

1 ICON "../res/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUMBERS
 PRODUCTVERSION APP_VERSION_NUMBERS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Discord HDR Helper"
            VALUE "FileVersion", APP_VERSION
            VALUE "InternalName", "DiscordHDRHelper"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "DiscordHDRHelper.exe"
            VALUE "ProductName", "Discord HDR Helper"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
